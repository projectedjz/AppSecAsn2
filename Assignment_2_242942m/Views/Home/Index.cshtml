
@{
    ViewData["Title"] = "Member Profile – Bookworms Online";
}

<div class="container mt-5 mb-5">
    <div class="row">
        <!-- Profile Photo Card -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm text-center">
                <div class="card-body p-4">
                    <div class="mb-3">
                        <img src="~/Uploads/@Model.PhotoPath" class="rounded-circle shadow-sm"
                             style="width: 150px; height: 150px; object-fit: cover;"
                             alt="Profile Photo" />
                    </div>
                    <h3 class="mb-1">@Model.FirstName @Model.LastName</h3>
                    <p class="text-muted mb-3">
                        <i class="bi bi-envelope me-1"></i>@Model.Email
                    </p>

                    <div class="d-grid gap-2 mb-3">
                        <a asp-action="ChangePassword" asp-controller="Account" class="btn btn-primary">
                            <i class="bi bi-key-fill me-2"></i>Change Password
                        </a>

                        <form asp-action="Logout" asp-controller="Account" method="post">
                            <button type="submit" class="btn btn-outline-danger w-100">
                                <i class="bi bi-box-arrow-right me-2"></i>Logout
                            </button>
                        </form>
                    </div>

                    <!-- 2FA Status -->
                    <div class="border-top pt-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="fw-semibold">
                                <i class="bi bi-shield-check me-1"></i>Two-Factor Auth
                            </span>
                            @if (Model.TwoFactorEnabled)
                            {
                                <span class="badge bg-success">Enabled</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Disabled</span>
                            }
                        </div>
                        <div class="mt-2">
                            @if (Model.TwoFactorEnabled)
                            {
                                <a asp-controller="Account" asp-action="Disable2FA"
                                   class="btn btn-sm btn-outline-secondary w-100">
                                    <i class="bi bi-x-circle me-1"></i>Disable 2FA
                                </a>
                            }
                            else
                            {
                                <a asp-action="Enable2FA" asp-controller="Account" class="btn btn-sm btn-success w-100">
                                    <i class="bi bi-shield-plus me-1"></i>Enable 2FA
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Profile Details Card -->
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-person-circle me-2"></i>Profile Information
                    </h4>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <!-- Contact Information -->
                        <div class="col-12">
                            <h5 class="border-bottom pb-2 mb-3">
                                <i class="bi bi-telephone-fill text-primary me-2"></i>Contact Information
                            </h5>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted small mb-1">Email Address</label>
                            <p class="fw-semibold mb-0">
                                <i class="bi bi-envelope me-2 text-primary"></i>@Model.Email
                            </p>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted small mb-1">Mobile Number</label>
                            <p class="fw-semibold mb-0">
                                <i class="bi bi-phone me-2 text-primary"></i>@Model.MobileNo
                            </p>
                        </div>

                        <!-- Address Information -->
                        <div class="col-12">
                            <h5 class="border-bottom pb-2 mb-3 mt-2">
                                <i class="bi bi-geo-alt-fill text-primary me-2"></i>Address Information
                            </h5>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted small mb-1">Billing Address</label>
                            <p class="fw-semibold mb-0">
                                <i class="bi bi-credit-card me-2 text-primary"></i>@Model.BillingAddress
                            </p>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted small mb-1">Shipping Address</label>
                            <p class="fw-semibold mb-0">
                                <i class="bi bi-box-seam me-2 text-primary"></i>@Model.ShippingAddress
                            </p>
                        </div>

                        <!-- Payment Information -->
                        <div class="col-12">
                            <h5 class="border-bottom pb-2 mb-3 mt-2">
                                <i class="bi bi-wallet2 text-primary me-2"></i>Payment Information
                            </h5>
                        </div>

                        <div class="col-12">
                            <label class="text-muted small mb-1">Credit Card</label>
                            <p class="fw-semibold mb-0">
                                <i class="bi bi-credit-card-2-front me-2 text-primary"></i>
                                <span class="font-monospace">@Model.CreditCardMasked</span>
                            </p>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="row mt-4 pt-3 border-top">
                        <div class="col-12">
                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-action="ChangePassword" asp-controller="Account" class="btn btn-outline-secondary">
                                    <i class="bi bi-shield-lock me-2"></i>Security Settings
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        border-radius: 10px;
    }

    .card-header {
        border-radius: 10px 10px 0 0 !important;
    }

    .rounded-circle {
        border: 3px solid #f8f9fa;
    }

    .font-monospace {
        letter-spacing: 2px;
    }
</style>
