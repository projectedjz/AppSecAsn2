@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-key-fill text-primary" style="font-size: 3rem;"></i>
                        <h2 class="mt-3">Change Password</h2>
                        <p class="text-muted">Update your account password</p>
                    </div>

                    @if (ViewBag.Warning != null)
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Warning
                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="ChangePassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-semibold">
                                <i class="bi bi-lock me-1"></i>Current Password
                            </label>
                            <input asp-for="CurrentPassword" class="form-control" placeholder="Enter current password" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold">
                                <i class="bi bi-lock-fill me-1"></i>New Password
                            </label>
                            <input asp-for="NewPassword" class="form-control" id="pw"
                                   oninput="checkStrength()" placeholder="Enter new password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            <div class="mt-2">
                                <div class="d-flex align-items-center gap-2">
                                    <meter id="meter" max="5" value="0" class="flex-grow-1" style="width: 100%; height: 8px;"></meter>
                                    <span id="strText" class="badge bg-secondary">Not entered</span>
                                </div>
                                <div class="form-text">
                                    <small><i class="bi bi-info-circle me-1"></i>Min 12 chars with uppercase, lowercase, digit & special character</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">
                                <i class="bi bi-check-circle me-1"></i>Confirm New Password
                            </label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter new password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-arrow-clockwise me-2"></i>Change Password
                            </button>
                        </div>

                        <div class="text-center">
                            <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                                <i class="bi bi-arrow-left me-1"></i>Back to Home
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function checkStrength() {
            const val = document.getElementById('pw').value;
            let score = 0;
            if (val.length >= 12) score++;
            if (/[a-z]/.test(val)) score++;
            if (/[A-Z]/.test(val)) score++;
            if (/\d/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            const meter = document.getElementById('meter');
            const badge = document.getElementById('strText');

            meter.value = score;

            const levels = [
                { text: 'Not entered', color: 'bg-secondary' },
                { text: 'Very Weak', color: 'bg-danger' },
                { text: 'Weak', color: 'bg-danger' },
                { text: 'Fair', color: 'bg-warning' },
                { text: 'Good', color: 'bg-warning' },
                { text: 'Strong', color: 'bg-success' }
            ];

            badge.className = `badge ${levels[score].color}`;
            badge.innerText = levels[score].text;
        }
    </script>

    <style>
        meter {
            width: 100%;
            height: 8px;
        }

            meter::-webkit-meter-bar {
                background: #e9ecef;
                border-radius: 4px;
            }

            meter::-webkit-meter-optimum-value {
                background: linear-gradient(to right, #dc3545, #ffc107, #198754);
                border-radius: 4px;
            }

            meter::-moz-meter-bar {
                background: linear-gradient(to right, #dc3545, #ffc107, #198754);
                border-radius: 4px;
            }
    </style>
}
