@model LoginViewModel
@{
    ViewData["Title"] = "Login – Bookworms Online";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-book-fill text-primary" style="font-size: 3rem;"></i>
                        <h2 class="mt-3">Welcome Back</h2>
                        <p class="text-muted">Login to your Bookworms account</p>
                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">
                                <i class="bi bi-envelope me-1"></i>Email Address
                            </label>
                            <input asp-for="Email" class="form-control form-control-lg"
                                   type="email" placeholder="your.email@example.com" autofocus />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold">
                                <i class="bi bi-lock me-1"></i>Password
                            </label>
                            <input asp-for="Password" class="form-control form-control-lg"
                                   type="password" placeholder="Enter your password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 text-end">
                            <a asp-action="ResetPassword" class="text-decoration-none small">
                                <i class="bi bi-key me-1"></i>Forgot your password?
                            </a>
                        </div>

                        <input asp-for="RecaptchaToken" type="hidden" id="RecaptchaToken" />

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Login
                            </button>
                        </div>

                        <div class="text-center small text-muted mb-2">
                            <i class="bi bi-shield-check me-1"></i>
                            This site is protected by reCAPTCHA
                        </div>

                        <hr class="my-4">

                        <div class="text-center">
                            <p class="mb-0">
                                Don't have an account?
                                <a asp-action="Register" class="text-decoration-none fw-semibold">
                                    <i class="bi bi-person-plus me-1"></i>Register here
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://www.google.com/recaptcha/api.js?render=@ViewBag.SiteKey"></script>
    <script>
        function fetchNewToken() {
            grecaptcha.ready(function () {
                grecaptcha.execute('@ViewBag.SiteKey', { action: 'login' }).then(function (token) {
                    document.getElementById("RecaptchaToken").value = token;
                    console.log("New reCAPTCHA token fetched");
                });
            });
        }

        // Get new token when page loads
        fetchNewToken();

        // Refresh token every 60 seconds
        setInterval(fetchNewToken, 60000);
    </script>
}
