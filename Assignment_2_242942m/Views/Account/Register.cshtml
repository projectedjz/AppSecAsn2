@model RegisterViewModel
@{
    ViewData["Title"] = "Register – Bookworms Online";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-book-fill text-primary" style="font-size: 3rem;"></i>
                        <h2 class="mt-3">Join Bookworms Online</h2>
                        <p class="text-muted">Create your membership account</p>
                    </div>

                    <form asp-action="Register" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label fw-semibold">
                                    <i class="bi bi-person me-1"></i>First Name
                                </label>
                                <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label fw-semibold">
                                    <i class="bi bi-person me-1"></i>Last Name
                                </label>
                                <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Photo" class="form-label fw-semibold">
                                <i class="bi bi-image me-1"></i>Profile Photo (JPG only)
                            </label>
                            <input asp-for="Photo" class="form-control" accept=".jpg,.jpeg" />
                            <span asp-validation-for="Photo" class="text-danger small"></span>
                            <div class="form-text">
                                <small><i class="bi bi-info-circle me-1"></i>Upload a JPG/JPEG image (max 5MB)</small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CreditCardNo" class="form-label fw-semibold">
                                    <i class="bi bi-credit-card me-1"></i>Credit Card Number
                                </label>
                                <input asp-for="CreditCardNo" class="form-control" placeholder="1234 5678 9012 3456" />
                                <span asp-validation-for="CreditCardNo" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="MobileNo" class="form-label fw-semibold">
                                    <i class="bi bi-phone me-1"></i>SG Mobile Number
                                </label>
                                <input asp-for="MobileNo" class="form-control" placeholder="81234567" />
                                <span asp-validation-for="MobileNo" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BillingAddress" class="form-label fw-semibold">
                                <i class="bi bi-geo-alt me-1"></i>Billing Address
                            </label>
                            <textarea asp-for="BillingAddress" class="form-control" rows="2"
                                      placeholder="Enter billing address"></textarea>
                            <span asp-validation-for="BillingAddress" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ShippingAddress" class="form-label fw-semibold">
                                <i class="bi bi-box-seam me-1"></i>Shipping Address
                            </label>
                            <textarea asp-for="ShippingAddress" class="form-control" rows="2"
                                      placeholder="Enter shipping address"></textarea>
                            <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">
                                <i class="bi bi-envelope me-1"></i>Email Address (Username)
                            </label>
                            <input asp-for="Email" class="form-control" type="email"
                                   placeholder="your.email@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold">
                                <i class="bi bi-lock me-1"></i>Password
                            </label>
                            <input asp-for="Password" class="form-control" id="pw"
                                   oninput="checkStrength()" placeholder="Create a strong password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            <div class="mt-2">
                                <div class="d-flex align-items-center gap-2">
                                    <meter id="meter" max="5" value="0" class="flex-grow-1" style="width: 100%; height: 8px;"></meter>
                                    <span id="strText" class="badge bg-secondary">Not entered</span>
                                </div>
                                <div class="form-text">
                                    <small><i class="bi bi-info-circle me-1"></i>Min 12 chars with uppercase, lowercase, digit & special character</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">
                                <i class="bi bi-lock-fill me-1"></i>Confirm Password
                            </label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter your password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-person-plus-fill me-2"></i>Create Account
                            </button>
                        </div>

                        <hr class="my-4">

                        <div class="text-center">
                            <p class="mb-2">
                                Already have an account?
                                <a asp-action="Login" class="text-decoration-none fw-semibold">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Login here
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function checkStrength() {
            const val = document.getElementById('pw').value;
            let score = 0;
            if (val.length >= 12) score++;
            if (/[a-z]/.test(val)) score++;
            if (/[A-Z]/.test(val)) score++;
            if (/\d/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            const meter = document.getElementById('meter');
            const badge = document.getElementById('strText');

            meter.value = score;

            const levels = [
                { text: 'Not entered', color: 'bg-secondary' },
                { text: 'Very Weak', color: 'bg-danger' },
                { text: 'Weak', color: 'bg-danger' },
                { text: 'Fair', color: 'bg-warning' },
                { text: 'Good', color: 'bg-warning' },
                { text: 'Strong', color: 'bg-success' }
            ];

            badge.className = `badge ${levels[score].color}`;
            badge.innerText = levels[score].text;
        }

        // JPG file validation
        document.querySelector('input[name="Photo"]').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const ext = file.name.toLowerCase().split('.').pop();
                const validExts = ['jpg', 'jpeg'];

                if (!validExts.includes(ext)) {
                    alert('Only JPG/JPEG files are allowed!');
                    e.target.value = '';
                    return false;
                }

                // Check file size (max 5MB)
                const maxSize = 5 * 1024 * 1024;
                if (file.size > maxSize) {
                    alert('File size must be less than 5MB!');
                    e.target.value = '';
                    return false;
                }
            }
        });
    </script>

    <style>
        meter {
            width: 100%;
            height: 8px;
        }

            meter::-webkit-meter-bar {
                background: #e9ecef;
                border-radius: 4px;
            }

            meter::-webkit-meter-optimum-value {
                background: linear-gradient(to right, #dc3545, #ffc107, #198754);
                border-radius: 4px;
            }

            meter::-moz-meter-bar {
                background: linear-gradient(to right, #dc3545, #ffc107, #198754);
                border-radius: 4px;
            }
    </style>
}
