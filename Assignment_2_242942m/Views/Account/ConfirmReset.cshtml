@model ConfirmResetViewModel

@{
    ViewData["Title"] = "Reset Your Password";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-key-fill text-success" style="font-size: 3rem;"></i>
                        <h2 class="mt-3">Create New Password</h2>
                        <p class="text-muted">Your new password must be different from previous passwords.</p>
                    </div>

                    <form asp-action="ConfirmReset" method="post">
                        <input asp-for="Email" type="hidden" />
                        <input asp-for="Token" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="NewPassword" class="form-label fw-semibold">New Password</label>
                            <input asp-for="NewPassword" type="password" class="form-control form-control-lg"
                                   placeholder="Enter new password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            <div class="form-text">
                                <small><i class="bi bi-info-circle me-1"></i>Min 12 characters with uppercase, lowercase, number & special character</small>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control form-control-lg"
                                   placeholder="Confirm new password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle-fill me-2"></i>Reset Password
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
