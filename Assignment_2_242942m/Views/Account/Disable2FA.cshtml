@{
    ViewData["Title"] = "Disable 2FA";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-danger">
                <div class="card-body p-4">
                    <h3 class="mb-2 text-danger">Disable Two-Factor Authentication</h3>
                    <p class="text-muted mb-4">
                        This removes the authenticator requirement for your account. You will log in with password only.
                    </p>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-warning" role="alert">
                            @ViewBag.Error
                        </div>

                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            Back to Home
                        </a>
                    }
                    else
                    {
                        <div class="rounded border bg-light p-3 mb-4">
                            <div class="row">
                                <div class="col-4 text-muted">Member ID</div>
                                <div class="col-8 fw-semibold">@ViewBag.MemberId</div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-4 text-muted">Email</div>
                                <div class="col-8 fw-semibold">@ViewBag.Email</div>
                            </div>
                        </div>

                        <form asp-controller="Account" asp-action="Disable2FAConfirmed" method="post">
                            @Html.AntiForgeryToken()

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-danger btn-lg">Yes, disable 2FA</button>
                                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                    Cancel
                                </a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
